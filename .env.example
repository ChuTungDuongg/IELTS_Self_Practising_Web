# Backend (copy to backend/.env or export from your shell)
DATABASE_URL=postgresql+asyncpg://ielts:ielts@localhost:5433/ielts
FRONTEND_ORIGIN=http://localhost:3000
# Required for authentication: set a unique secret of at least 32 characters in backend/.env.
JWT_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
STORAGE_ROOT=../storage
# local (default), s3 (AWS), or r2 (Cloudflare); changing this does not move existing files.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
# R2: https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
S3_ENDPOINT_URL=
# Optional safe relative namespace, e.g. staging/media (no leading/trailing slash).
S3_KEY_PREFIX=
# Server-side only. Prefer an IAM role / AWS credential chain on AWS.
# R2 requires its scoped token's access-key/secret-key pair.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=100
MAX_TRANSFER_ZIP_MB=300
MAX_TRANSFER_UNCOMPRESSED_MB=600
MAX_TRANSFER_FILES=5000

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Docker Compose
POSTGRES_DB=ielts
POSTGRES_USER=ielts
POSTGRES_PASSWORD=ielts

# Admin-only private dataset preparation; no paid inference. Worker runs separately.
SPEAKING_BENCHMARK_EXECUTION=local
SPEAKING_BENCHMARK_MAX_UPLOAD_MB=100
SPEAKING_BENCHMARK_MAX_DURATION_SECONDS=1200
SPEAKING_BENCHMARK_DIARIZATION_PYTHON=
SPEAKING_BENCHMARK_MODEL_DIR=
SPEAKING_BENCHMARK_THREADS=2
SPEAKING_BENCHMARK_MEMORY_MB=4096
SPEAKING_BENCHMARK_TIMEOUT_SECONDS=3600
# Remote mode requires external PostgreSQL + shared R2/S3; embedded Modal is gated.
# Phase 2 paid-capable grading stays disabled; each queued run also needs consent.
SPEAKING_BENCHMARK_GRADING_ENABLED=false
SPEAKING_BENCHMARK_RESEARCH_ENABLED=false
SPEAKING_BENCHMARK_RESEARCH_ALLOW_LIVE=false
SPEAKING_BENCHMARK_RESEARCH_MAX_SAMPLES=50
SPEAKING_BENCHMARK_RESEARCH_MAX_PROVIDER_SECONDS=3600
SPEAKING_BENCHMARK_GRADING_ALLOW_LIVE=false

# Private Speaking recordings: per chunk and per logical take bounds.
SPEAKING_MAX_CHUNK_BYTES=2097152
SPEAKING_MAX_RESPONSE_BYTES=33554432
# Recovery eligibility from last ACK and interruption; one 7-second grace per take.
SPEAKING_RECOVERY_WINDOW_SECONDS=45
SPEAKING_ASR_ENABLED=false
SPEAKING_ASR_PROVIDER=local
# Azure CPU opt-in: set ASR_ENABLED=true and ASR_PROVIDER=azure after private setup.
# Canonical backend-only names (no SPEECH_ aliases):
SPEAKING_AZURE_KEY=
SPEAKING_AZURE_REGION=japaneast
SPEAKING_AZURE_LOCALE=en-US
SPEAKING_AZURE_ALLOW_PAID=false
SPEAKING_AZURE_BILLING_MODE=unknown
SPEAKING_AZURE_PROSODY=true
SPEAKING_LEXICAL_ASR_PROVIDER=azure_pa
SPEAKING_LEXICAL_ASR_ALLOW_ADDITIONAL_REQUESTS=false
SPEAKING_LEXICAL_ASR_ALLOW_GPU=false
# Independent cloud ASR needs explicit estimates/budget; see docs/speaking-transcription.md.
# SPEAKING_LEXICAL_ASR_ESTIMATED_COST_USD_PER_MINUTE=0.10
# SPEAKING_LEXICAL_ASR_MAX_ESTIMATED_COST_USD_PER_RESPONSE=0.50
# SPEAKING_AZURE_SEGMENTATION_SILENCE_TIMEOUT_MS=500
SPEAKING_ASR_BASE_URL=
SPEAKING_ASR_MODEL_DIRECTORY=
SPEAKING_ASR_MODEL=local-model
SPEAKING_ASR_MODEL_REVISION=local
SPEAKING_ASR_VERSION=faster-whisper-v1
SPEAKING_ASR_LANGUAGE=en
SPEAKING_NORMALIZER_VERSION=pcm-v1
SPEAKING_FFMPEG_PATH=ffmpeg
SPEAKING_PROCESSING_TIMEOUT_SECONDS=120
SPEAKING_MAX_DECODED_SECONDS=600
SPEAKING_TRANSCRIPT_STALE_SECONDS=300
# Optional bounded JSON overrides; defaults are versioned energy/noise proxies.
SPEAKING_QUALITY={}
# CPU acoustic proxies only; no models or IELTS scores.
SPEAKING_PRONUNCIATION_ENABLED=true
SPEAKING_PRONUNCIATION={}

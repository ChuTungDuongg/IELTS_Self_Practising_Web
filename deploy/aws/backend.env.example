# Fictional placeholders. Put real values only in the ignored backend.env.
DATABASE_URL=postgresql+asyncpg://bandpilot:REPLACE_PASSWORD@database.example.invalid:5432/bandpilot?ssl=verify-full
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
IELTS_DEPLOYMENT_ENV=production
IELTS_AUTO_MIGRATE=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
STORAGE_BACKEND=s3
S3_BUCKET=bandpilot-production-assets
S3_REGION=us-east-1
S3_KEY_PREFIX=production/media
# R2: STORAGE_BACKEND=r2, S3_REGION=auto, plus its account endpoint:
# S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=R2_TOKEN_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=R2_TOKEN_SECRET_KEY
# S3 on EC2 normally uses an instance role; do not set static AWS keys.
AI_WRITING_ENABLED=false
SPEAKING_AI_ENABLED=false
SPEAKING_ASR_ENABLED=false
# Optional existing protected AI endpoints/credentials remain backend-only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://bandpilot.example.com/api/v1/auth/oauth/google/callback

# Separate CPU container. Never included by deploy/modal/app.py or the Web image.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /usr/local/bin/uv
WORKDIR /workspace
COPY backend /workspace/backend
COPY tools/speaking_diarization /workspace/tools/speaking_diarization
COPY scripts/speaking_benchmark_worker.py /workspace/scripts/speaking_benchmark_worker.py
RUN uv sync --project backend --locked --no-dev --extra benchmark-cpu && uv sync --project tools/speaking_diarization --locked
ENV SPEAKING_BENCHMARK_EXECUTION=remote \
    SPEAKING_BENCHMARK_MODEL_DIR=/models/pyannote-community-1 \
    SPEAKING_BENCHMARK_DIARIZATION_PYTHON=/workspace/tools/speaking_diarization/.venv/bin/python \
    HF_HUB_OFFLINE=1 PYANNOTE_METRICS_ENABLED=false
# Mount a persistent, private, pre-provisioned /models cache. No per-job download.
CMD ["uv", "run", "--project", "backend", "--no-sync", "python", "scripts/speaking_benchmark_worker.py"]

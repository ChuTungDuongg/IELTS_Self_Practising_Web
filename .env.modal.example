# Copy to .env.modal. Use pre-created, isolated staging resources.
# AI proxy credentials are read privately from backend/.env, never this file.
MODAL_PROFILE=your-profile
MODAL_ENVIRONMENT=main
# Optional absolute executable path if modal is not on PATH:
# MODAL_CLI_PATH=C:/path/to/modal.exe
IELTS_MODAL_MODE=dev
IELTS_MODAL_STORAGE_BACKEND=local
IELTS_MODAL_DATABASE_MODE=embedded
IELTS_MODAL_DATABASE_VOLUME=your-staging-database
IELTS_MODAL_ASSETS_VOLUME=your-staging-assets
IELTS_MODAL_SNAPSHOTS_VOLUME=your-staging-snapshots
IELTS_MODAL_CONFIG_SECRET=your-staging-config
IELTS_MODAL_REQUIRE_ASSET_ISOLATION=true
IELTS_WEB_AI_ENABLED=true
IELTS_WEB_SPEAKING_ASR_ENABLED=true
# This is a Web feature gate, not a request to deploy Whisper/T4.
# The actual provider comes from SPEAKING_ASR_PROVIDER in backend/.env through the launcher.
# azure -> existing Web CPU; modal -> legacy T4; enabled local fails in the Modal image.
# Opt in to CPU speech + OpenAI Luna (Azure credentials belong in backend/.env):
# Select SPEAKING_ASR_PROVIDER=azure in backend/.env; it selects speaking_hybrid_v1.
# IELTS_WEB_AI_PROVIDER=openai
# IELTS_WEB_SPEAKING_VAD_MODEL_PATH=storage/models/silero-v6.0.onnx
# Setup once: python scripts/setup_speaking_vad.py storage/models/silero-v6.0.onnx
# The optional experimental chart specialist remains off.
IELTS_WEB_CHART_SPECIALIST_ENABLED=false
IELTS_WRITING_LLM_PROFILE=cost
IELTS_WRITING_LLM_SCALEDOWN_SECONDS=60

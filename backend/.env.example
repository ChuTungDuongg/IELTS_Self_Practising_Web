DATABASE_URL=postgresql+asyncpg://ielts:ielts@localhost:5433/ielts
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_ROOT=../storage
# local (default), s3 (AWS), or r2 (Cloudflare); changing this does not move existing files.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
# R2: https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
S3_ENDPOINT_URL=
# Optional safe relative namespace, e.g. staging/media (no leading/trailing slash).
S3_KEY_PREFIX=
# Server-side only. Prefer an IAM role / AWS credential chain on AWS.
# R2 requires its scoped token's access-key/secret-key pair.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Generate a unique value of at least 32 characters for every deployment.
JWT_SECRET=
JWT_ISSUER=devweblocalforielts
JWT_AUDIENCE=devweblocalforielts-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# One-time values read by: python -m app.bootstrap_admin
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Advisory Task 2 scoring. All inference credentials stay in FastAPI.
AI_WRITING_ENABLED=false
AI_WRITING_PROVIDER=vllm
AI_WRITING_VLLM_BASE_URL=
AI_WRITING_VLLM_API_KEY=
AI_WRITING_VLLM_MODEL=mistralai/Ministral-3-8B-Instruct-2512
# Modal proxy token pair (required for the protected Modal deployment).
AI_WRITING_MODAL_KEY=
AI_WRITING_MODAL_SECRET=
AI_WRITING_REQUEST_TIMEOUT_SECONDS=300
AI_WRITING_STARTUP_TIMEOUT_SECONDS=600
# Per run, shared by perception, claims, evidence, scoring and repairs (1–4).
AI_WRITING_MAX_CONCURRENT_LLM_REQUESTS=2
AI_WRITING_PROMPT_VERSION=mts-task2-v6
AI_WRITING_STALE_AFTER_SECONDS=90
# Dormant unless provider=openai and this key is set.
AI_WRITING_OPENAI_API_KEY=
AI_WRITING_OPENAI_MODEL=gpt-6-luna
AI_WRITING_OPENAI_BASE_URL=https://api.openai.com/v1
# Shared per process/event loop across Writing and Speaking, not per run/replica.
AI_WRITING_OPENAI_MAX_CONCURRENT_REQUESTS=4
AI_WRITING_OPENAI_MAX_QUEUED_REQUESTS=16
# Total completion safety cap includes internal reasoning and visible JSON.
# Old explicit 4096 caps fail profile validation; migrate intentionally or lower
# every active stage budget explicitly after evaluating quality/cost.
AI_WRITING_OPENAI_MAX_OUTPUT_TOKENS=32768
AI_WRITING_OPENAI_PROFILE=openai_task1_reasoned_v1
AI_WRITING_OPENAI_REASONING_EFFORT=low
# high is an initial evaluation default; auto/low are configurable.
# original fails safely until Luna+Chat support is explicitly established.
AI_WRITING_OPENAI_IMAGE_DETAIL=high
AI_WRITING_OPENAI_LOW_COMPLETION_TOKENS=8192
AI_WRITING_OPENAI_MEDIUM_COMPLETION_TOKENS=16384
AI_WRITING_OPENAI_REPAIR_COMPLETION_TOKENS=32768
AI_WRITING_OPENAI_TASK1_IMAGE_ASSESSMENT=true
# One logical stage timeout includes admission and one possible budget repair.
AI_WRITING_OPENAI_STAGE_TIMEOUT_SECONDS=300
AI_WRITING_OPENAI_RUN_TIMEOUT_SECONDS=1800
# Canonical stage override precedence: task.stage.criterion > task.stage > profile.
# Global safety cap is validated, never silently clamped against legacy JSON caps.
# AI_WRITING_OPENAI_STAGE_OVERRIDES={"task1.scoring.ta":{"reasoning_effort":"high","total_completion_tokens":32768,"timeout_seconds":300,"image_detail":"high"}}
# Readiness GET retries only; POSTs have one explicit length-budget repair,
# never replay after timeout/5xx/refusal/filter/cancellation.
AI_WRITING_OPENAI_READINESS_RETRIES=2

# Optional chart/table-only second perception pass; backend endpoint never sent to frontend.
AI_WRITING_CHART_SPECIALIST_ENABLED=false
AI_WRITING_CHART_SPECIALIST_PROVIDER=deplot
AI_WRITING_DEPLOT_MODEL=google/deplot
AI_WRITING_DEPLOT_REVISION=6e76d62430da16986be3426bae32301fb9115397
AI_WRITING_DEPLOT_BASE_URL=
AI_WRITING_CHART_SPECIALIST_TIMEOUT_SECONDS=90

# Private Speaking recordings: per chunk and per logical take bounds.
SPEAKING_MAX_CHUNK_BYTES=2097152
SPEAKING_MAX_RESPONSE_BYTES=33554432
# Recovery eligibility from last ACK and interruption; one 7-second grace per take.
SPEAKING_RECOVERY_WINDOW_SECONDS=45
SPEAKING_ASR_ENABLED=false
# Opt-in only; does not change legacy providers or deployed services.
SPEAKING_PROFILE=legacy
SPEAKING_AZURE_KEY=
SPEAKING_AZURE_REGION=
SPEAKING_AZURE_LOCALE=en-US
SPEAKING_AZURE_PROSODY=true
SPEAKING_AZURE_TIMEOUT_SECONDS=180
SPEAKING_AZURE_MAX_CONCURRENCY=2
SPEAKING_AZURE_MAX_QUEUE=8
# Explicit setup: python scripts/setup_speaking_vad.py storage/models/silero-v6.0.onnx
SPEAKING_VAD_MODEL_PATH=
SPEAKING_VAD_MODEL_SHA256=597d30b3ec076608d059477bb14cfeffdf951bf5cae370d38f65d33bbfe82004
SPEAKING_ASR_PROVIDER=local
SPEAKING_ASR_BASE_URL=
SPEAKING_ASR_MODEL_DIRECTORY=
SPEAKING_ASR_MODEL=local-model
SPEAKING_ASR_MODEL_REVISION=local
SPEAKING_ASR_VERSION=faster-whisper-v1
SPEAKING_ASR_LANGUAGE=en
SPEAKING_NORMALIZER_VERSION=pcm-v1
SPEAKING_FFMPEG_PATH=ffmpeg
SPEAKING_PROCESSING_TIMEOUT_SECONDS=120
SPEAKING_MAX_DECODED_SECONDS=600
SPEAKING_TRANSCRIPT_STALE_SECONDS=300
# Optional bounded JSON overrides; defaults are versioned energy/noise proxies.
SPEAKING_QUALITY={}
# CPU acoustic proxies only; no models or IELTS scores.
SPEAKING_PRONUNCIATION_ENABLED=true
SPEAKING_PRONUNCIATION={}

# Advisory Speaking grading. Reuses backend-only Writing transport credentials.
# Provider/model can be overridden independently; no model is loaded at startup.
SPEAKING_AI_ENABLED=false
SPEAKING_AI_PROVIDER=
SPEAKING_AI_MODEL=
SPEAKING_AI_PROMPT_VERSION=speaking-score-v1
SPEAKING_AI_RUBRIC_VERSION=speaking-rubric-v1
SPEAKING_AI_SCORE_MAX_TOKENS=192
SPEAKING_AI_FEEDBACK_MAX_TOKENS=1024
SPEAKING_AI_STALE_SECONDS=300
SPEAKING_AI_TRANSCRIPT_WAIT_SECONDS=900
SPEAKING_AI_MAX_INPUT_CHARACTERS=60000
